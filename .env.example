APP_NAME="SPBE Kabupaten Malang"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=spbe_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_EXPIRE_ON_CLOSE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Monitoring Configuration
MONITORING_LOGGING_ENABLED=true
MONITORING_LOG_SLOW_QUERIES=true
MONITORING_SLOW_QUERY_THRESHOLD=1000
MONITORING_LOG_API_CALLS=true

MONITORING_PERFORMANCE_ENABLED=true
MONITORING_SLOW_REQUEST_THRESHOLD=2000
MONITORING_TRACK_MEMORY=true
MONITORING_MEMORY_THRESHOLD=100

MONITORING_HEALTH_CHECK_ENABLED=true
MONITORING_HEALTH_CHECK_INTERVAL=300
MONITORING_HEALTH_CHECK_TIMEOUT=10

MONITORING_ALERTS_ENABLED=true
MONITORING_API_DOWN_THRESHOLD=3
MONITORING_SLOW_REQUEST_ALERT=true
MONITORING_HIGH_MEMORY_ALERT=true

# API Endpoints for Health Monitoring
BERITA_API_URL=
INFORMASI_API_URL=

# Sentry Error Tracking (Optional)
SENTRY_LARAVEL_DSN=
SENTRY_TRACING_ENABLED=true
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.2

# Backup Configuration (Optional)
BACKUP_MAIL_TO=
BACKUP_ARCHIVE_PASSWORD=

# Slack Notifications (Optional)
LOG_SLACK_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# ============================================
# Google reCAPTCHA Configuration
# ============================================
RECAPTCHA_ENABLED=false
RECAPTCHA_VERSION=v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SCORE_THRESHOLD=0.5
